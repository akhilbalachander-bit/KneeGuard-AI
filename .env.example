# KneeGuard AI — configuration. Copy to .env and fill in.
#
#     cp .env.example .env
#
# .env is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# Supabase — optional. Accounts and saved history switch off when unset.
# ---------------------------------------------------------------------------
# Both values come from your Supabase project:
#   Project Settings -> API -> Project URL, and the "anon / public" key.
#
# Only ever use the ANON key here. It is designed to be public — it ships in
# the browser — and Row Level Security is what protects the data.
#
# NEVER put the service_role key in this file or anywhere the frontend can
# reach: it bypasses Row Level Security completely and can read and delete
# every user's data.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Claude — optional. Without it, explanations use the built-in rule writer.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8000
